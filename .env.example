# Root environment template.
# Copy to backend/.env and fill in the values below.
# See backend/.env.example for the full list with defaults.

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=

# Authentication - replace with a strong secret
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS - comma-separated list
FRONTEND_URL=http://localhost:5173

# Frontend (copy to frontend/.env)
# VITE_API_URL=http://localhost:5000/api

# Optional grounded generation; the system reports a local fallback when omitted
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_MS=15000

# Python four-agent service (embeddings + FAISS retrieval + grounded generation)
# The backend auto-starts this service unless PYTHON_SERVICE_AUTOSTART=false.
PYTHON_SERVICE_AUTOSTART=true
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_HOST=127.0.0.1
PYTHON_SERVICE_PORT=8000
PYTHON_SERVICE_TIMEOUT_MS=15000
PYTHON_PIPELINE_TIMEOUT_MS=60000
PYTHON_SERVICE_START_TIMEOUT_MS=45000
# Optional explicit interpreter, e.g. C:\path\to\ai-services\.venv\Scripts\python.exe
PYTHON_COMMAND=
PYTHON_AGENT_TIMEOUT_MS=15000


