# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=

# Authentication - replace with a strong secret in your local .env
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS - comma-separated list.
# In development, any localhost origin (http://localhost:<any-port>) is also
# allowed automatically. This value is enforced in production.
FRONTEND_URL=http://localhost:5173

# Optional grounded generation. Without a key the app uses a transparent local fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_MS=15000

# Python four-agent service (local embeddings + FAISS retrieval + grounded generation).
# The backend auto-starts it on boot unless PYTHON_SERVICE_AUTOSTART=false.
PYTHON_SERVICE_AUTOSTART=true
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_HOST=127.0.0.1
PYTHON_SERVICE_PORT=8000
PYTHON_SERVICE_TIMEOUT_MS=15000
PYTHON_PIPELINE_TIMEOUT_MS=60000
PYTHON_SERVICE_START_TIMEOUT_MS=45000
# Optional explicit interpreter, e.g. ai-services\.venv\Scripts\python.exe
PYTHON_COMMAND=
PYTHON_AGENT_TIMEOUT_MS=15000

# API rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300


# Official social-platform API credentials (server-side only)
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_API_VERSION=v23.0
X_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_VERSION=202508

